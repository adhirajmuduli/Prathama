# Frontend environment variables.
#
# Copy this file to .env.local for local development. Never commit a populated
# .env.local. No value in this file is a secret: the browser only learns the
# public origin of the API.

# Server-only origin of the scientific API. The server renders the service
# status through this origin, so the browser never needs to reach it.
BACKEND_API_ORIGIN=http://localhost:8000

# Public origin of the API used by browser code. When it is set, the service
# status panel refreshes itself in the browser; when it is empty, the panel
# shows the status that the server rendered.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public origin of this site. Used for the canonical URL, the sitemap, and the
# robots policy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Timeout of a server-side API call in milliseconds.
TRENDSMAPP_API_TIMEOUT_MS=10000

# Contact route (src/app/api/contact/route.ts). The route answers 503 when any
# of these is absent. SECRET (never commit real values; store them in the
# platform's secret manager — Netlify's scanner still scans these keys):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# UPSTASH_REST_URL=https://your-upstash-id.upstash.io
# UPSTASH_REST_TOKEN=your-upstash-token
# RESEND_API_KEY=re_your_resend_key
# CONTACT_FROM_EMAIL=contact@your-domain.example
# CONTACT_TO_EMAIL=ops@your-domain.example
# CONTACT_HASH_SECRET=your-hmac-secret
# CONTACT_RATE_LIMIT_WINDOW_MS=3600000
# CONTACT_RATE_LIMIT_IP_PER_WINDOW=5
# CONTACT_RATE_LIMIT_EMAIL_PER_WINDOW=3
# CONTACT_IDEMPOTENCY_TTL_SECONDS=86400
