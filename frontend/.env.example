# Frontend environment variables.
#
# Copy this file to .env.local for local development. Never commit a populated
# .env.local. No value in this file is a secret: the browser only learns the
# public origin of the API.

# Server-only origin of the scientific API. The server renders the service
# status through this origin, so the browser never needs to reach it.
BACKEND_API_ORIGIN=http://localhost:8000

# Public origin of the API used by browser code. When it is set, the service
# status panel refreshes itself in the browser; when it is empty, the panel
# shows the status that the server rendered.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public origin of this site. Used for the canonical URL, the sitemap, and the
# robots policy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Timeout of a server-side API call in milliseconds.
TRENDSMAPP_API_TIMEOUT_MS=10000
