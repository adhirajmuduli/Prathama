# Copy this file to .env for local development. Never commit a populated .env.
# Every variable below is safe to share: no production secret belongs in this file.

# ---------------------------------------------------------------------------
# Backend (backend/)
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
TRENDSMAPP_ENVIRONMENT=development

# PostgreSQL is used in production; SQLite is convenient for local experiments.
TRENDSMAPP_DATABASE_URL=postgresql+asyncpg://trendsmapp:trendsmapp@localhost:5432/trendsmapp

# Object store: local | s3
TRENDSMAPP_OBJECT_STORE_BACKEND=local
TRENDSMAPP_LOCAL_STORAGE_ROOT=./.local/objects

# S3-compatible object store (used when TRENDSMAPP_OBJECT_STORE_BACKEND=s3)
# TRENDSMAPP_S3_BUCKET=trendsmapp
# TRENDSMAPP_S3_ENDPOINT_URL=http://localhost:9000
# TRENDSMAPP_S3_REGION=us-east-1
# TRENDSMAPP_S3_ACCESS_KEY_ID=
# TRENDSMAPP_S3_SECRET_ACCESS_KEY=

# Public origins allowed to call the API, and the hostnames the API accepts.
TRENDSMAPP_CORS_ALLOW_ORIGINS=http://localhost:3000
TRENDSMAPP_TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Request ceilings. The upload ceiling is enforced by the browser, the proxy,
# the API middleware, and the parser.
TRENDSMAPP_UPLOAD_MAX_BYTES=104857600
TRENDSMAPP_REQUEST_MAX_BODY_BYTES=16777216

# Ingestion policy. A formula cell is rejected as data unless this is enabled;
# when it is enabled, the cached value written by the spreadsheet application
# is used and the substitution is recorded in the parse report.
TRENDSMAPP_INGESTION_ACCEPT_CACHED_FORMULA_VALUES=false

# Analysis CRS and logging.
TRENDSMAPP_ANALYSIS_CRS=EPSG:32644
TRENDSMAPP_LOG_LEVEL=info
TRENDSMAPP_LOG_JSON=true

# Worker polling.
TRENDSMAPP_WORKER_POLL_INTERVAL_SECONDS=2
TRENDSMAPP_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
TRENDSMAPP_WORKER_STALE_AFTER_SECONDS=120

# Build metadata recorded in run manifests.
# TRENDSMAPP_BUILD_COMMIT=
# TRENDSMAPP_BUILD_TIMESTAMP=
# TRENDSMAPP_BUILD_BUILDER=

# ---------------------------------------------------------------------------
# Frontend (frontend/)
# ---------------------------------------------------------------------------

# Public API origin used by the browser. Leave empty to use the Next.js server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only API origin used by server components and route handlers.
BACKEND_API_ORIGIN=http://localhost:8000

# Contact route (implemented in a later phase; no secret is required yet).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=
