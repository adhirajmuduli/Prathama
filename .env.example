# Copy this file to .env for local development. Never commit a populated .env.
# Every variable below is safe to share: no production secret belongs in this file.

# ---------------------------------------------------------------------------
# Backend (backend/)
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
TRENDSMAPP_ENVIRONMENT=development

# PostgreSQL is used in production; SQLite is convenient for local experiments.
# Placeholders only — set real values in your local .env, never commit them.
TRENDSMAPP_DATABASE_URL=postgresql+asyncpg://your-db-user:your-db-password@localhost:5432/trendsmapp

# Service credentials for `docker compose up` (consumed by docker-compose.yml,
# which refuses to start without them). Placeholders only.
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=trendsmapp
MINIO_ROOT_USER=your-object-store-user
MINIO_ROOT_PASSWORD=your-object-store-password

# Object store: local | s3
TRENDSMAPP_OBJECT_STORE_BACKEND=local
TRENDSMAPP_LOCAL_STORAGE_ROOT=./.local/objects

# S3-compatible object store (used when TRENDSMAPP_OBJECT_STORE_BACKEND=s3)
# TRENDSMAPP_S3_BUCKET=trendsmapp
# TRENDSMAPP_S3_ENDPOINT_URL=http://localhost:9000
# TRENDSMAPP_S3_REGION=us-east-1
# TRENDSMAPP_S3_ACCESS_KEY_ID=your-access-key-id
# TRENDSMAPP_S3_SECRET_ACCESS_KEY=your-secret-access-key

# Public origins allowed to call the API, and the hostnames the API accepts.
# List-valued variables must be JSON in this file (pydantic-settings parses
# them as JSON): TRENDSMAPP_CORS_ALLOW_ORIGINS=["http://localhost:3000"]
TRENDSMAPP_CORS_ALLOW_ORIGINS=["http://localhost:3000"]
TRENDSMAPP_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]

# Request ceilings. The upload ceiling is enforced by the browser, the proxy,
# the API middleware, and the parser.
TRENDSMAPP_UPLOAD_MAX_BYTES=104857600
TRENDSMAPP_REQUEST_MAX_BODY_BYTES=16777216

# Ingestion policy. A formula cell is rejected as data unless this is enabled;
# when it is enabled, the cached value written by the spreadsheet application
# is used and the substitution is recorded in the parse report.
TRENDSMAPP_INGESTION_ACCEPT_CACHED_FORMULA_VALUES=false

# Analysis CRS and logging.
TRENDSMAPP_ANALYSIS_CRS=EPSG:32644
TRENDSMAPP_LOG_LEVEL=info
TRENDSMAPP_LOG_JSON=true

# Worker polling.
TRENDSMAPP_WORKER_POLL_INTERVAL_SECONDS=2
TRENDSMAPP_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
TRENDSMAPP_WORKER_STALE_AFTER_SECONDS=120

# Build metadata recorded in run manifests.
# TRENDSMAPP_BUILD_COMMIT=
# TRENDSMAPP_BUILD_TIMESTAMP=
# TRENDSMAPP_BUILD_BUILDER=

# ---------------------------------------------------------------------------
# Frontend (frontend/)
# ---------------------------------------------------------------------------

# Public API origin used by the browser. Leave empty to use the Next.js server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only API origin used by server components and route handlers.
BACKEND_API_ORIGIN=http://localhost:8000

# Public origin of the site, used for the sitemap and canonical URL.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact route (frontend/src/app/api/contact/route.ts). All optional: the
# route answers 503 when they are absent. Placeholders only.
# SECRET (never commit real values; store them in the deployment platform's
# secret manager — Netlify secret scanning still scans these keys):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# UPSTASH_REST_URL=https://your-upstash-id.upstash.io
# UPSTASH_REST_TOKEN=your-upstash-token
# RESEND_API_KEY=re_your_resend_key
# CONTACT_FROM_EMAIL=contact@your-domain.example
# CONTACT_TO_EMAIL=ops@your-domain.example
# CONTACT_HASH_SECRET=your-hmac-secret
# CONTACT_RATE_LIMIT_WINDOW_MS=3600000
# CONTACT_RATE_LIMIT_IP_PER_WINDOW=5
# CONTACT_RATE_LIMIT_EMAIL_PER_WINDOW=3
# CONTACT_IDEMPOTENCY_TTL_SECONDS=86400

# CI-only ephemeral service credentials (throwaway containers, never real
# secrets). In GitHub Actions these come from repository variables/secrets.
# CI_POSTGRES_PASSWORD=ci-ephemeral-placeholder
# CI_S3_SECRET=ci-ephemeral-placeholder

# Legacy prototype (root app.py): session signing key. When unset, the app
# persists a generated key to SECRET_FILE (default <repo>/.secret); on
# read-only filesystems (e.g. Render) set SECRET_FILE to a writable path or
# accept the in-memory fallback. Placeholder only.
# SECRET_KEY=your-long-random-secret-key
# SECRET_FILE=/tmp/trendsmapp-secret
